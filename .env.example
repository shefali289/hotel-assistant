# Local defaults only; no secrets. Copy each line to where its app reads it (see README, Environment setup).
# web: put this in web/.env.local; the API base URL the browser calls.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# api: set in the shell before uvicorn; success-scenario delay in milliseconds (DEC-5, default 800).
FIXTURE_DELAY_MS=800
